# export these before `uvicorn app:app --port 8000`. Everything is optional; unset = offline fallbacks.
ANTHROPIC_API_KEY=            # LLM planner
ELEVENLABS_API_KEY=           # Scribe (voice in) + TTS (voice out)
ELEVENLABS_TTS_MODEL=eleven_v3        # Kannada needs v3 or newer; Multilingual v2 has none
ELEVENLABS_VOICE_ID=
ELEVENLABS_API_BASE=          # e.g. https://api.in.residency.elevenlabs.io for India residency
WHATSAPP_TOKEN=               # WhatsApp Cloud API
WHATSAPP_PHONE_ID=
APPROVER_WHATSAPP=            # approver number, country code first
PROXY_BASE_URL=               # public URL of this app (ngrok etc.) so the WhatsApp link opens on the approver's phone
PROXY_SECRET=                 # signs approval links; change from the dev default
GOOGLE_TOKEN_FILE=            # authorized-user token.json with gmail.readonly + calendar.readonly; pip install -r requirements-optional.txt

# --- access control (auth is ON by default) ---
PROXY_APPROVER_KEY=           # sign-in key for the approver. Unset = generated at startup and printed as a link
PROXY_REQUESTER_KEY=          # same, for the requester
# PROXY_SECRET (above) also signs sessions; set all three to keep sign-ins valid across restarts
PROXY_ALLOW_RESET=            # 1 = approver may wipe state (run_demo.sh sets it; never on a public deployment)
PROXY_AUTH=                   # off = no auth at all, local development only
